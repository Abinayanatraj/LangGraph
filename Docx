 # 10\. `src/graph.py`

 This is the most important part of the project.

 The LangGraph workflow is:

```
START
  ↓
retrieve
  ↓
generate
  ↓
validate
  ↓
END
```

 Complete implementation:

```
from typing import Any, Dict, List, TypedDict

from langchain_core.documents import Document
from langchain_openai import ChatOpenAI
from langgraph.graph import END, START, StateGraph

from src.config import (
    LLM_MODEL,
    RETRIEVAL_THRESHOLD,
    TOP_K,
)
from src.prompts import (
    GROUNDING_PROMPT,
    SYSTEM_PROMPT,
)
from src.retriever import retrieve_documents

class AgentState(TypedDict):
    question: str
    context: List[Dict[str, Any]]
    answer: str
    confidence_score: float
    grounded: bool

def format_context(
    results: List[tuple[Document, float]],
) -> List[Dict[str, Any]]:
    """Convert LangChain documents to API-friendly objects."""

    formatted = []

    for document, score in results:
        page = int(
            document.metadata.get("page", 0)
        )

        formatted.append(
            {
                "text": document.page_content,
                "page": page,
                "retrieval_score": float(score),
            }
        )

    return formatted

def calculate_retrieval_confidence(
    results: List[tuple[Document, float]],
) -> float:
    """
    Calculate a retrieval-based confidence estimate.

    Pinecone/LangChain score semantics can vary by integration,
    so this value is used as an indicator rather than a
    mathematically calibrated probability.
    """

    if not results:
        return 0.0

    scores = [
        max(0.0, min(1.0, float(score)))
        for _, score in results
    ]

    # Give more weight to the strongest retrieved document.
    strongest = max(scores)

    if len(scores) == 1:
        return round(strongest, 3)

    average = sum(scores) / len(scores)

    confidence = (
        0.7 * strongest
        + 0.3 * average
    )

    return round(
        max(0.0, min(1.0, confidence)),
        3,
    )

def build_rag_graph():
    """Build and compile the LangGraph RAG workflow."""

    llm = ChatOpenAI(
        model=LLM_MODEL,
        temperature=0,
    )

    def retrieve_node(
        state: AgentState,
    ) -> Dict[str, Any]:
        """Retrieve relevant chunks from Pinecone."""

        results = retrieve_documents(
            question=state["question"],
            top_k=TOP_K,
        )

        context = format_context(results)

        return {
            "context": context,
        }

    def generate_node(
        state: AgentState,
    ) -> Dict[str, Any]:
        """Generate an answer using only retrieved context."""

        context = state["context"]

        if not context:
            return {
                "answer": (
                    "I cannot answer based on the "
                    "provided document."
                ),
                "confidence_score": 0.0,
            }

        best_score = max(
            item["retrieval_score"]
            for item in context
        )

        if best_score < RETRIEVAL_THRESHOLD:
            return {
                "answer": (
                    "I cannot answer based on the "
                    "provided document."
                ),
                "confidence_score": round(
                    max(0.0, best_score),
                    3,
                ),
            }

        context_text = "\n\n".join(
            [
                (
                    f"[Page {item['page']}]\n"
                    f"{item['text']}"
                )
                for item in context
            ]
        )

        prompt = SYSTEM_PROMPT.format(
            context=context_text,
            question=state["question"],
        )

        response = llm.invoke(prompt)

        answer = response.content

        retrieval_confidence = (
            calculate_retrieval_confidence(
                [
                    (
                        Document(
                            page_content=item["text"],
                            metadata={
                                "page": item["page"]
                            },
                        ),
                        item["retrieval_score"],
                    )
                    for item in context
                ]
            )
        )

        return {
            "answer": answer,
            "confidence_score": retrieval_confidence,
        }

    def validate_node(
        state: AgentState,
    ) -> Dict[str, Any]:
        """
        Perform a lightweight grounding validation.

        This uses the LLM as a verifier in addition to
        retrieval confidence.
        """

        answer = state["answer"]
        context = state["context"]

        if not context:
            return {
                "grounded": False,
                "confidence_score": 0.0,
            }

        if answer.strip() == (
            "I cannot answer based on the provided document."
        ):
            return {
                "grounded": False,
                "confidence_score": 0.0,
            }

        context_text = "\n\n".join(
            [
                (
                    f"[Page {item['page']}]\n"
                    f"{item['text']}"
                )
                for item in context
            ]
        )

        prompt = GROUNDING_PROMPT.format(
            context=context_text,
            question=state["question"],
            answer=answer,
        )

        result = llm.invoke(prompt)
        evaluation = result.content.strip()

        grounded = "GROUNDED: YES" in evaluation

        confidence = state[
            "confidence_score"
        ]

        # Extract confidence if the model supplied it.
        for line in evaluation.splitlines():
            if line.upper().startswith("CONFIDENCE:"):
                try:
                    model_score = float(
                        line.split(":", 1)[1].strip()
                    )

                    model_score = max(
                        0.0,
                        min(1.0, model_score),
                    )

                    # Combine retrieval and grounding scores.
                    confidence = round(
                        (
                            0.5 * confidence
                            + 0.5 * model_score
                        ),
                        3,
                    )

                except ValueError:
                    pass

        if not grounded:
            return {
                "answer": (
                    "I cannot answer based on the "
                    "provided document."
                ),
                "grounded": False,
                "confidence_score": min(
                    confidence,
                    0.3,
                ),
            }

        return {
            "grounded": True,
            "confidence_score": confidence,
        }

    workflow = StateGraph(AgentState)

    workflow.add_node(
        "retrieve",
        retrieve_node,
    )

    workflow.add_node(
        "generate",
        generate_node,
    )

    workflow.add_node(
        "validate",
        validate_node,
    )

    workflow.add_edge(
        START,
        "retrieve",
    )

    workflow.add_edge(
        "retrieve",
        "generate",
    )

    workflow.add_edge(
        "generate",
        "validate",
    )

    workflow.add_edge(
        "validate",
        END,
    )

    return workflow.compile()
```

 ### Important note about confidence

 Don't describe the resulting `confidence_score` as a mathematically calibrated probability.

 In your README, call it something like:

 > A heuristic confidence indicator combining retrieval relevance and an LLM-based grounding validation.

 That's more technically honest.

